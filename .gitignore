# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.lighthouseci
budget.json
__pycache__/
/public/vendor/
scripts/archive/spc.csv

# Android packaging: only the TWA config is source; the generated project, builds and the
# signing keystore never enter the repository.
/packaging/android/*
!/packaging/android/twa-manifest.json
*.keystore
*.jks
/public/version.json
